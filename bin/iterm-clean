#!/bin/zsh -f
# iterm2-tools: iterm-clean
# 개발 프로젝트 폴더(하위 포함)에서 다시 만들 수 있는 캐시·빌드 산출물·의존성 폴더를 찾아
# 드라이런으로 보여 주고, 사용자가 확인(yes 입력)하면 휴지통으로 옮긴다. 영구 삭제는 하지 않는다.
#
#   iterm-clean [-c 범주] [폴더]           드라이런(기본) — 아무것도 바꾸지 않는다
#   iterm-clean --trash [-c 범주] [폴더]   목록 → 확인(yes) → 휴지통으로 이동
#   iterm-clean --menu [폴더]              우클릭 메뉴 "정리(clean)": 범위 선택 → 드라이런 결과(변경 없음)
#                                          → 사용자가 결과 확인 → yes 면 그 결과 그대로 휴지통 / Enter 면 종료
#   iterm-clean --rules                    판정 규칙 표 출력
#   iterm-clean --print0 [-c 범주] [폴더]  후보 경로만 NUL 구분으로 출력(스크립트·테스트용, 드라이런)
#
# 범주(-c, 쉼표로 여러 개, 기본 cache,build):
#   cache  이름만으로 확실한 캐시 (__pycache__, .pytest_cache, .next, .DS_Store …)
#   build  빌드 산출물 — 같은 폴더에 해당 언어의 빌드 파일이 있을 때만 (target+Cargo.toml …)
#   deps   설치된 의존성 — 지우면 다시 설치해야 함 (node_modules, .venv+pyvenv.cfg …)
#   all    위 전부
#
# 안전장치:
# - 이름이 흔한 폴더(build·dist·target·bin·obj·vendor·env …)는 "증거 파일"이 있어야 대상이 된다.
# - git 저장소 안에서 추적 중인 파일이 들어 있으면 건너뛴다(git 이 없어 확인할 수 없으면 역시 건너뜀).
# - .git/.hg/.svn, *.app/*.framework 안으로는 들어가지 않는다. 심볼릭 링크는 따라가지도, 대상으로 삼지도 않는다.
# - 다른 디스크(볼륨)로 넘어가지 않는다(find -x).
# - /, 홈 폴더 자체, ~/Library, ~/.숨김폴더, 시스템 폴더는 거부한다.
# - .env* 같은 비밀 파일은 어떤 규칙으로도 대상이 되지 않으며, 파일 내용은 절대 읽지 않는다(이름만 본다).
# - 확인 후에는 다시 찾지 않고 "보여 준 목록 그대로"만 옮긴다(그 사이 바뀐 항목은 건너뜀).
#
# 점검용 환경 변수(테스트 전용):
#   IT2_CLEAN_NO_TRASH_CMD=1   /usr/bin/trash 대신 mv 방식(이전 macOS 용 대체 경로)을 쓴다
#   IT2_CLEAN_TRASH_DIR=<폴더>  mv 방식의 휴지통 위치(기본 ~/.Trash)
#   IT2_CLEAN_NO_GIT=1         git 이 없는 Mac 처럼 동작(저장소 안 후보는 확인 불가 → 건너뜀)

emulate zsh
setopt no_unset pipe_fail extended_glob

# ── 언어 선택 (iterm2-tools 공통 — 모든 실행 파일에 같은 코드. tests/test_lang.zsh 가 일치를 확인) ──
#   IT2_LANG(en|kr) → ~/.config/iterm2-tools/lang (install.sh --lang 이 저장) → macOS 언어 → en
#   IT2_TEST_SYS_LANG: 테스트용 macOS 언어 흉내(설정돼 있으면 defaults 대신 사용, 빈 값 = 언어 정보 없음)
it2_lang() {
  local v=${IT2_LANG:-} f=$HOME/.config/iterm2-tools/lang
  [[ -z $v && -r $f ]] && v=$(<$f)
  [[ -z $v ]] && v=${IT2_TEST_SYS_LANG-$(/usr/bin/defaults read -g AppleLanguages 2>/dev/null | /usr/bin/sed -n '2{s/[^A-Za-z_-]//g;p;}')}
  case ${v:l} in (kr|ko|ko[-_]*) REPLY=kr ;; (*) REPLY=en ;; esac
}
it2_lang; IT2_L=$REPLY
t() { if [[ $IT2_L == kr ]]; then print -r -- "$1"; else print -r -- "$2"; fi }   # t '한국어' 'English'

PROG=iterm-clean

# 영어 문구의 항목 수 표기 "1 item" / "N items" (결과는 REPLY). 한국어 문구는 숫자를 직접 쓴다
n_items() { if (( $1 == 1 )); then REPLY="1 item"; else REPLY="$1 items"; fi }

# 반복문(항목마다) 안에서 쓰는 문구는 $(t …) 서브셸을 매번 만들지 않도록 시작할 때 한 번만 정한다
M_IN=$(t '안에 ' 'contains ')
M_SRC_PRE=$(t '원본 ' 'source ') M_SRC_POST=$(t ' 있음' ' exists')
M_NO_GIT=$(t 'git 저장소 안인데 git 이 없어 추적 여부를 확인할 수 없음' 'inside a git repository, but git is not available to check what is tracked')
M_GIT_FAIL=$(t 'git 추적 여부 확인 실패' 'could not check git tracking')
M_GIT_TRACKED=$(t 'git 이 추적하는 파일 포함' 'contains files tracked by git')
M_PROTECTED=$(t '보호 대상 이름' 'protected name')
M_NESTED_GIT=$(t '안에 별도 git 저장소(.git)가 있음' 'contains a separate git repository (.git)')
M_TSBUILD=$(t '주의: tsconfig 의 tsBuildInfoFile 파일도 지워야 다시 빌드됨' 'note: also remove the tsBuildInfoFile set in tsconfig, or tsc will not rebuild')

# ── 판정 규칙 ────────────────────────────────────────────────
# 범주|종류(d=폴더 f=파일)|이름(glob)|증거(비우면 이름만으로 판정. 쉼표=하나라도 있으면.
#                                    in:X = 그 폴더 안에 X 가 있어야 함. stem:.py = 같은 이름의 .py 가 옆에 있어야 함.
#                                    그 외 = 같은 폴더(형제)에 있어야 함)
# 범주를 쉼표로 여러 개 쓰면 그중 하나라도 선택됐을 때 대상(예: cache,build)
typeset -ga RULES=(
  # Python
  'cache|d|__pycache__|'          'cache|d|.pytest_cache|'       'cache|d|.mypy_cache|'
  'cache|d|.ruff_cache|'          'cache|d|.hypothesis|'         'cache|d|.ipynb_checkpoints|'
  'cache|d|.tox|'                 'cache|d|.nox|'                'cache|d|.pytype|'
  'cache|d|*.egg-info|'           'cache|d|.eggs|'               'cache|d|htmlcov|'
  # __pycache__ 밖의 .pyc 는 원본 .py 가 옆에 있을 때만(.py 없는 .pyc 는 그 모듈의 유일한 사본일 수 있음)
  'cache|f|*.pyc|stem:.py'        'cache|f|*.pyo|stem:.py'       'cache|f|.coverage|'
  # JavaScript / TypeScript
  'cache|d|.next|'                'cache|d|.nuxt|'               'cache|d|.svelte-kit|'
  'cache|d|.parcel-cache|'        'cache|d|.turbo|'              'cache|d|.nyc_output|'
  'cache|d|.sass-cache|'          'cache|f|.eslintcache|'
  'cache|f|npm-debug.log*|'       'cache|f|yarn-error.log|'
  # JVM / C·C++ / Apple / Zig / Elixir
  # CMakeFiles 는 build/·cmake-build-* 와 함께만 지운다(소스 폴더에 직접 빌드한 경우 CMakeCache.txt·Makefile 이
  # 남아 반쪽 상태가 될 수 있고 cmake 가 없어 실측하지 못했으므로 단독으로는 지우지 않음)
  'cache|d|.kotlin|'              'cache|d|cmake-build-*|'
  'cache|d|DerivedData|'          'cache|d|.zig-cache|'          'cache|d|zig-cache|'
  'cache|d|.elixir_ls|'
  # OS 찌꺼기
  'cache|f|.DS_Store|'            'cache|f|Thumbs.db|'
  # 빌드 산출물 — 증거 필요
  'build|d|target|Cargo.toml,pom.xml,build.sbt'
  'build|d|build|build.gradle,build.gradle.kts,settings.gradle,settings.gradle.kts,CMakeLists.txt,pubspec.yaml,setup.py,pyproject.toml'
  'build|d|dist|package.json,pyproject.toml,setup.py'
  'build|d|.gradle|build.gradle,build.gradle.kts,settings.gradle,settings.gradle.kts'
  'build|d|bin|*.csproj,*.fsproj,*.vbproj'
  'build|d|obj|*.csproj,*.fsproj,*.vbproj'
  'build|d|.build|Package.swift'
  'build|d|.dart_tool|pubspec.yaml'
  'build|d|_build|mix.exs,rebar.config'
  'build|d|.stack-work|stack.yaml'
  'build|d|dist-newstyle|cabal.project,*.cabal'
  'build|d|zig-out|build.zig'
  'build|d|.angular|angular.json'
  'build|d|coverage|package.json'
  # TypeScript 증분 빌드 기록. 실측(tsc 5.6.3): 이것만 지우면 안전(다음 빌드가 전체 빌드),
  # dist 만 지우고 이것이 남으면 tsc·tsc -b 모두 다시 출력하지 않는다 → 캐시·빌드 어느 쪽을 골라도 항상 지운다
  'cache,build|f|*.tsbuildinfo|'
  # 설치된 의존성 — 지우면 다시 설치해야 함
  'deps|d|node_modules|'          'deps|d|bower_components|'     'deps|d|.pnpm-store|'
  'deps|d|.venv|in:pyvenv.cfg'    'deps|d|venv|in:pyvenv.cfg'    'deps|d|env|in:pyvenv.cfg'
  'deps|d|vendor|composer.json'
  'deps|d|Pods|Podfile'
  'deps|d|deps|mix.exs'
)
# 절대 들어가지 않는 폴더 (안쪽도 보지 않음)
typeset -ga NEVER_ENTER=( .git .hg .svn '*.app' '*.framework' '*.xcarchive' )

typeset -gA CAT_LABEL=( cache "$(t '캐시' 'cache')" build "$(t '빌드' 'build')" deps "$(t '의존성' 'deps')" )

# 주의: 스크립트(비대화형 셸)에서는 read 'x?프롬프트' 의 프롬프트가 표시되지 않는다 → print 로 먼저 출력
ask() { print -rn -- "$1"; REPLY=""; read -r REPLY }
menu_end() { print; ask "$(t 'Enter 키를 누르면 이 탭을 닫습니다.' 'Press Enter to close this tab.')" || true; exit ${1:-0} }
# 메뉴 모드에서는 탭이 끝나면 바로 닫히므로, 오류도 Enter 를 기다린 뒤 끝낸다(안 그러면 메시지를 볼 수 없음)
die()  { print -ru2 -- "$PROG: $*"; [[ ${mode:-} == menu ]] && menu_end 2; exit 2 }

usage() {   # 한 줄씩 t 로 출력(서브셸 없음)
  t '사용법: iterm-clean [옵션] [폴더]        (폴더 기본값: 현재 폴더)' \
    'Usage: iterm-clean [options] [folder]   (default folder: the current folder)'
  print
  t '  (옵션 없음), -n, --dry-run' '  (no option), -n, --dry-run'
  t '                     드라이런 — 지울 대상만 보여 주고 아무것도 바꾸지 않습니다' \
    '                     Dry run — list what would be cleaned without changing anything'
  t '  -t, --trash        목록을 보여 준 뒤 yes 를 입력하면 휴지통으로 옮깁니다(영구 삭제 아님)' \
    '  -t, --trash        Show the list, then move it to the Trash if you type yes (never deletes permanently)'
  t '  -c, --categories   cache,build,deps 중 쉼표로 선택 / all  (기본: cache,build)' \
    '  -c, --categories   Comma-separated list of cache,build,deps, or all  (default: cache,build)'
  t '      --menu         대화형: 드라이런 결과 → 확인 후 yes 면 정리, Enter 면 종료(우클릭 메뉴 "정리(clean)")' \
    '      --menu         Interactive: dry-run results, then yes to clean or Enter to finish (right-click menu "Clean…")'
  t '      --rules        판정 규칙 표 보기' '      --rules        Show the matching rules'
  t '  -h, --help         이 도움말' '  -h, --help         Show this help'
  print
  t '예)  iterm-clean                 # 현재 폴더 드라이런' \
    'Examples:'$'\n''     iterm-clean                 # dry run in the current folder'
  print -r -- '     iterm-clean -c all ~/work/app'
  t '     iterm-clean --trash         # 확인 후 휴지통으로' \
    '     iterm-clean --trash         # confirm, then move to the Trash'
}

print_rules() {
  local r c k n m dir file
  dir=$(t '폴더' 'dir') file=$(t '파일' 'file')
  t '범주    종류  이름                 증거(없으면 이름만으로 판정)' \
    'Cat.    Type  Name                 Evidence (— = the name alone decides)'
  for r in $RULES; do
    c=${r%%|*}; r=${r#*|}; k=${r%%|*}; r=${r#*|}; n=${r%%|*}; m=${r#*|}
    printf '%-7s %-5s %-20s %s\n' $c ${${k:/d/$dir}:/f/$file} $n ${m:-—}
  done
  t "들어가지 않음: ${(j:, :)NEVER_ENTER}" "Never entered: ${(j:, :)NEVER_ENTER}"
}

hsize() {  # KB → 사람이 읽는 크기
  local k=$1
  if (( k >= 1048576 )); then printf '%.1fG' $(( k / 1048576.0 ))
  elif (( k >= 1024 )); then printf '%.1fM' $(( k / 1024.0 ))
  else printf '%dK' $k; fi
}

# ── 시작 폴더 검사 ──────────────────────────────────────────
check_root() {  # $1 = 실제 경로(:A)
  local r=$1 h=${HOME:A} p
  [[ -d $r ]] || die "$(t "폴더가 아닙니다: $r" "Not a folder: $r")"
  [[ $r == / ]] && die "$(t '루트(/)는 정리할 수 없습니다.' 'The root folder (/) cannot be cleaned.')"
  [[ $r == $h ]] && die "$(t '홈 폴더 전체는 정리할 수 없습니다. 프로젝트 폴더에서 실행하세요.' 'The whole home folder cannot be cleaned. Run this in a project folder.')"
  (( ${#${(s:/:)r}} >= 3 )) || die "$(t "너무 넓은 폴더입니다(최소 3단계 깊이 필요): $r" "Folder is too broad (must be at least 3 levels deep): $r")"
  [[ $r == $h/Library(|/*) || $r == $h/.[^/]##(|/*) ]] &&
    die "$(t "앱 데이터·설정 폴더(~/Library, ~/.*)는 정리할 수 없습니다: $r" "App data and settings folders (~/Library, ~/.*) cannot be cleaned: $r")"
  for p in /System /Library /Applications /usr /bin /sbin /opt /cores /private/etc /private/var/db; do
    [[ $r == $p(|/*) ]] && die "$(t "시스템 폴더는 정리할 수 없습니다: $r" "System folders cannot be cleaned: $r")"
  done
  return 0
}

# ── git 추적 여부 ───────────────────────────────────────────
typeset -g GIT_BIN=""
git_setup() {
  [[ -n ${IT2_CLEAN_NO_GIT:-} ]] && return     # 테스트용: 개발자 도구(git)가 없는 Mac 흉내
  local g=${commands[git]:-}
  [[ -z $g ]] && return
  if [[ $g == /usr/bin/git ]]; then
    # 개발자 도구가 없는 Mac 의 /usr/bin/git 은 설치 창을 띄우는 껍데기라서 부르지 않는다
    local d; d=$(/usr/bin/xcode-select -p 2>/dev/null) || return
    [[ -d $d ]] || return
  fi
  GIT_BIN=$g
}

typeset -gA REPO_OF=()
repo_top() {  # $1 폴더 → 그 폴더가 속한 저장소 최상위(없으면 빈 문자열). 결과는 REPLY
  local d=$1 start=$1
  if (( ${+REPO_OF[$start]} )); then REPLY=${REPO_OF[$start]}; return; fi
  REPLY=""
  while [[ $d != / ]]; do
    if [[ -e $d/.git ]]; then REPLY=$d; break; fi
    d=${d:h}
  done
  REPO_OF[$start]=$REPLY
}

tracked_reason() {  # $1 경로 → 건너뛸 이유(REPLY), 없으면 빈 문자열
  local p=$1 top out
  REPLY=""
  repo_top ${p:h}; top=$REPLY; REPLY=""
  [[ -z $top ]] && return
  if [[ -z $GIT_BIN ]]; then REPLY=$M_NO_GIT; return; fi
  out=$(GIT_OPTIONAL_LOCKS=0 $GIT_BIN -C $top ls-files -z -- ":(literal)${p#$top/}" 2>/dev/null) ||
    { REPLY=$M_GIT_FAIL; return; }
  [[ -n $out ]] && REPLY=$M_GIT_TRACKED
}

# ── 찾기 ────────────────────────────────────────────────────
typeset -ga C_PATH=() C_CAT=() C_WHY=() C_KB=() S_PATH=() S_WHY=()
typeset -gA EXCLUDED_CAT=()
typeset -g TOTAL_KB=0

match_rule() {  # $1 경로, $2 d|f → 맞는 규칙(REPLY="범주|증거"), 없으면 return 1
  local name=${1:t} r c t n m
  for r in $RULES; do
    c=${r%%|*}; r=${r#*|}; t=${r%%|*}; r=${r#*|}; n=${r%%|*}; m=${r#*|}
    [[ $t == $2 && $name == ${~n} ]] || continue
    REPLY="$c|$m"; return 0
  done
  return 1
}

evidence() {  # $1 경로, $2 증거목록 → 찾은 증거 이름(REPLY), 없으면 return 1
  local p=$1 m; local -a hit
  [[ -z $2 ]] && { REPLY=""; return 0 }
  for m in ${(s:,:)2}; do
    if [[ $m == in:* ]]; then
      [[ -e $p/${m#in:} ]] && { REPLY="$M_IN${m#in:}"; return 0 }
    elif [[ $m == stem:* ]]; then
      [[ -f ${p:r}${m#stem:} ]] && { REPLY="$M_SRC_PRE${${p:r}:t}${m#stem:}$M_SRC_POST"; return 0 }
    else
      hit=( ${p:h}/${~m}(N) )
      (( $#hit )) && { REPLY=${hit[1]:t}; return 0 }
    fi
  done
  return 1
}

scan() {  # $1 시작 폴더, $2.. 선택 범주
  local root=$1; shift
  local -a sel=( $@ ) prune=() dn=() dm=() fn=() found
  local r c t n m p a kind why
  local -A own=() rule_of=() why_of=()

  for n in $NEVER_ENTER; do prune+=( -o -name $n ); done
  for r in $RULES; do
    c=${r%%|*}; r=${r#*|}; t=${r%%|*}; r=${r#*|}; n=${r%%|*}; m=${r#*|}
    if [[ $t == f ]]; then fn+=( -o -name $n )
    elif [[ -z $m ]]; then dn+=( -o -name $n )     # 이름만으로 확정 → 안으로 들어가지 않음
    else dm+=( -o -name $n ); fi                   # 증거 확인 전 → 안쪽도 계속 본다
  done

  found=( ${(0)"$(/usr/bin/find -x $root -mindepth 1 \
      \( -type d \( ${prune[2,-1]} \) -prune \) -o \
      \( -type d \( ${dn[2,-1]} \) -print0 -prune \) -o \
      \( -type d \( ${dm[2,-1]} \) -print0 \) -o \
      \( -type f \( ${fn[2,-1]} \) -print0 \) 2>/dev/null)"} )

  # 1) 판정: 규칙이 확정된 폴더는 "주인"이 된다(범주 선택과 무관). 주인 안의 것은 따로 세지 않는다.
  for p in $found; do
    [[ -L $p ]] && continue
    [[ -d $p ]] && kind=d || kind=f
    match_rule $p $kind || continue
    c=${REPLY%%|*}; m=${REPLY#*|}
    evidence $p "$m" || continue
    rule_of[$p]=$c; why_of[$p]=$REPLY
    [[ $kind == d ]] && own[$p]=1
  done

  # 2) 바깥쪽 주인만 남기고, 선택한 범주만 후보로
  for p in ${(ok)rule_of}; do
    a=${p:h}; why=""
    while [[ $a == $root/* ]]; do
      (( ${+own[$a]} )) && { why=nested; break }
      a=${a:h}
    done
    [[ -n $why ]] && continue
    local -a rc=( ${(s:,:)rule_of[$p]} ) hitc=()
    for c in $rc; do (( ${sel[(Ie)$c]} )) && hitc+=( $c ); done
    c=${rc[1]}
    if (( ! $#hitc )); then EXCLUDED_CAT[$c]=$(( ${EXCLUDED_CAT[$c]:-0} + 1 )); continue; fi
    c=${hitc[1]}

    # 3) 안전 검사
    if [[ ${p:t} == .env* ]]; then S_PATH+=( "$p" ); S_WHY+=( "$M_PROTECTED" ); continue; fi
    tracked_reason $p
    if [[ -n $REPLY ]]; then S_PATH+=( "$p" ); S_WHY+=( "$REPLY" ); continue; fi
    if [[ $c != deps && -d $p && -n $(/usr/bin/find -x $p -mindepth 1 -name .git -print -quit 2>/dev/null) ]]; then
      S_PATH+=( "$p" ); S_WHY+=( "$M_NESTED_GIT" ); continue
    fi

    why=${why_of[$p]}
    if [[ ${p:t} == dist ]]; then
      local -a tsc_cfg=( ${p:h}/tsconfig*.json(N) )
      (( $#tsc_cfg )) && /usr/bin/grep -qs '"tsBuildInfoFile"' $tsc_cfg &&
        why+="${why:+, }$M_TSBUILD"
    fi
    C_PATH+=( "$p" ); C_CAT+=( "$c" ); C_WHY+=( "$why" )
    m=$(/usr/bin/du -skx -- $p 2>/dev/null); m=${m%%[[:space:]]*}
    [[ $m == <-> ]] || m=0
    C_KB+=( "$m" ); (( TOTAL_KB += m ))
  done
}

show() {  # $1 시작 폴더, $2 모드
  local root=$1 i rel tail
  t "폴더: ${(V)root}" "Folder: ${(V)root}"
  if (( $#C_PATH == 0 )); then
    t '정리할 항목이 없습니다.' 'Nothing to clean.'
  else
    for (( i = 1; i <= $#C_PATH; i++ )); do
      rel=${C_PATH[i]#$root/}; [[ -d ${C_PATH[i]} ]] && rel+=/
      tail=""; [[ -n ${C_WHY[i]} ]] && tail="   (${C_WHY[i]})"
      printf '  [%s] %7s  %s%s\n' ${CAT_LABEL[${C_CAT[i]}]} "$(hsize ${C_KB[i]})" "${(V)rel}" "$tail"
    done
    n_items $#C_PATH
    t "합계: $#C_PATH 개, $(hsize $TOTAL_KB)" "Total: $REPLY, $(hsize $TOTAL_KB)"
  fi
  if (( $#S_PATH )); then
    t '건너뜀(안전):' 'Skipped (for safety):'
    for (( i = 1; i <= $#S_PATH; i++ )); do
      print -r -- "  ${(V)S_PATH[i]#$root/} — ${S_WHY[i]}"
    done
  fi
  local c hint
  if [[ ${2:-} == menu ]]; then hint=$(t '범위 3 선택' 'choose option 3'); else hint=$(t '-c all' 'use -c all'); fi
  for c in ${(k)EXCLUDED_CAT}; do
    n_items ${EXCLUDED_CAT[$c]}
    t "참고: 선택하지 않은 범주 [${CAT_LABEL[$c]}] ${EXCLUDED_CAT[$c]}개는 제외했습니다(포함하려면 $hint)." \
      "Note: left out $REPLY in the unselected category [${CAT_LABEL[$c]}] (to include them, $hint)."
  done
}

# ── 휴지통 ──────────────────────────────────────────────────
move_to_trash() {  # $1 경로 → 0 성공
  local p=$1
  [[ $p == /* ]] || return 1             # 항상 절대 경로만 (- 로 시작하는 이름이 옵션으로 읽히지 않게)
  if [[ -x /usr/bin/trash && -z ${IT2_CLEAN_NO_TRASH_CMD:-} ]]; then
    # 주의(실측): /usr/bin/trash 는 -- 를 옵션 끝이 아니라 파일 이름 "--" 로 처리한다 → 쓰지 않는다
    /usr/bin/trash $p >/dev/null 2>&1
    return
  fi
  # 대체 경로: ~/.Trash 로 mv (macOS 14 이하). 같은 디스크일 때만.
  local T=${IT2_CLEAN_TRASH_DIR:-$HOME/.Trash} base dst n=2
  [[ -d $T ]] || /bin/mkdir -p -- $T || return 1
  [[ $(/usr/bin/stat -f %d -- ${p:h}) == $(/usr/bin/stat -f %d -- $T) ]] || return 3
  base=${p:t}; dst=$T/$base
  while [[ -e $dst || -L $dst ]]; do dst="$T/$base $n"; (( n++ )); done
  /bin/mv -n -- $p $dst && [[ ! -e $p ]]
}

do_trash() {
  local i p ok=0 fail=0 rc m_changed m_other_disk m_failed
  m_changed=$(t '  건너뜀(그 사이 바뀜): ' '  Skipped (changed in the meantime): ')
  m_other_disk=$(t '  실패(다른 디스크라 옮기지 않음): ' '  Failed (on a different disk, not moved): ')
  m_failed=$(t '  실패: ' '  Failed: ')
  for (( i = 1; i <= $#C_PATH; i++ )); do
    p=${C_PATH[i]}
    if [[ ! -e $p || -L $p ]]; then print -r -- "$m_changed${(V)p}"; (( fail++ )); continue; fi
    move_to_trash $p; rc=$?
    if (( rc == 0 )); then (( ok++ ))
    else
      (( fail++ ))
      (( rc == 3 )) && print -r -- "$m_other_disk${(V)p}" || print -r -- "$m_failed${(V)p}"
    fi
  done
  t "휴지통으로 옮김: ${ok}개 / 실패·건너뜀: ${fail}개" "Moved to the Trash: ${ok} / failed or skipped: ${fail}"
  (( ok )) && t '되돌리려면 Finder 의 휴지통에서 항목을 찾아 복원하세요.' 'To undo, find the items in the Trash in Finder and restore them.'
  (( fail == 0 ))
}

confirm() {   # 언어와 관계없이 정확히 yes 만 진행한다(번역하지 않음)
  local ans="" size=$(hsize $TOTAL_KB)
  n_items $#C_PATH
  print -rn -- "$(t "위 $#C_PATH 개(${size})를 휴지통으로 옮깁니다. 계속하려면 yes 를 입력하세요(그 외는 취소): " \
                    "Move the $REPLY above (${size}) to the Trash? Type yes to continue (anything else cancels): ")"
  read -r ans || { print; t '취소했습니다(입력 없음). 아무것도 바꾸지 않았습니다.' 'Cancelled (no input). Nothing was changed.'; return 1 }
  [[ $ans == yes ]] && return 0
  t '취소했습니다. 아무것도 바꾸지 않았습니다.' 'Cancelled. Nothing was changed.'
  return 1
}

# ── 실행 ────────────────────────────────────────────────────
mode=dry cats=cache,build root="" dryflag=""
while (( $# )); do
  case $1 in
    -t|--trash)       mode=trash ;;
    --menu)           mode=menu ;;
    -n|--dry-run)     dryflag=1 ;;
    --print0)         mode=print0 ;;
    -c|--categories)  (( $# >= 2 )) || die "$(t '-c 뒤에 범주가 필요합니다' '-c needs a category list')"; cats=$2; shift ;;
    --categories=*)   cats=${1#*=} ;;
    --rules)          print_rules; exit 0 ;;
    -h|--help)        usage; exit 0 ;;
    --)               shift; root=${1:-}; break ;;
    -*)               die "$(t "알 수 없는 옵션: $1 (도움말: $PROG -h)" "Unknown option: $1 (see $PROG -h)")" ;;
    *)                [[ -z $root ]] || die "$(t '폴더는 하나만 지정합니다' 'Specify only one folder')"; root=$1 ;;
  esac
  shift
done
[[ $mode == trash && -n $dryflag ]] && die "$(t '--trash 와 --dry-run 은 함께 쓸 수 없습니다' '--trash and --dry-run cannot be used together')"
[[ -n $root ]] || root=$PWD
root=${root:A}

if [[ $mode == menu ]]; then
  check_root $root
  t '── 현재 폴더 정리(clean) — 먼저 드라이런 결과를 보여 줍니다 ──' '── Clean the current folder — dry-run results come first ──'
  t "폴더: ${(V)root}" "Folder: ${(V)root}"
  t '  1) 캐시 + 빌드 산출물   (기본 — 그냥 Enter)' '  1) Caches + build output   (default — just press Enter)'
  t '  2) 캐시만' '  2) Caches only'
  t '  3) 전부 — 의존성(node_modules·.venv·Pods 등) 포함, 나중에 다시 설치해야 합니다' \
    '  3) Everything — includes dependencies (node_modules, .venv, Pods, …) that must be reinstalled later'
  t '  q) 취소' '  q) Cancel'
  ask "$(t '선택: ' 'Choice: ')" && sel=$REPLY || sel=q
  case $sel in
    ''|1) cats=cache,build ;; 2) cats=cache ;; 3) cats=all ;;
    *) t '취소했습니다. 아무것도 바꾸지 않았습니다.' 'Cancelled. Nothing was changed.'; menu_end 0 ;;
  esac
fi

[[ $cats == all ]] && cats=cache,build,deps
typeset -a SEL=( ${(s:,:)cats} )
for c in $SEL; do
  (( ${+CAT_LABEL[$c]} )) || die "$(t "알 수 없는 범주: $c (cache, build, deps, all)" "Unknown category: $c (use cache, build, deps, or all)")"
done

check_root $root
git_setup
[[ $mode == (dry|menu) ]] && t "드라이런 — 아무것도 바꾸지 않습니다. 범주: ${(j:, :)SEL}" "Dry run — nothing will be changed. Categories: ${(j:, :)SEL}"
scan $root $SEL
if [[ $mode == print0 ]]; then        # 기계용: 후보 절대 경로를 NUL 로 구분해 출력(드라이런과 같음, 아무것도 바꾸지 않음)
  (( $#C_PATH )) && print -rN -- $C_PATH
  exit 0
fi
show $root $mode

case $mode in
  dry)
    (( $#C_PATH )) && t "휴지통으로 옮기려면: $PROG --trash${${cats:#cache,build}:+ -c $cats} ${(q-)root}" \
                        "To move these to the Trash: $PROG --trash${${cats:#cache,build}:+ -c $cats} ${(q-)root}"
    exit 0 ;;
  trash)
    (( $#C_PATH )) || exit 0
    confirm || exit 0
    do_trash || exit 4 ;;
  menu)
    print
    t '▲ 드라이런 결과입니다. 아직 아무것도 바꾸지 않았습니다.' '▲ These are the dry-run results. Nothing has been changed yet.'
    (( $#C_PATH )) || menu_end 0
    t '  결과를 확인한 뒤 → 이 목록 그대로 정리하려면 yes / 정리하지 않고 끝내려면 Enter' \
      '  Review the list above. Type yes to move exactly these items to the Trash, or press Enter to finish without cleaning.'
    confirm || menu_end 0          # 확인 후 다시 찾지 않고 위 드라이런 목록만 옮긴다
    do_trash; menu_end $? ;;
esac
